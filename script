extends Control

var images: Array = [
	preload("res://images/image1.png"),
	preload("res://images/image2.png"),
	preload("res://images/image3.png")
]

var current_index: int = 0

@onready var display = $TextureRect

func _on_button_pressed() -> void:
	current_index += 1
	if current_index >= images.size():
		current_index = 0
	display.texture = images[current_index]
